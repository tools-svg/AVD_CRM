# Copy this file to backend/.env and fill in real values.
# Never commit real passwords or service-role keys.

PROJECT_NAME="AVD Group Management Platform"
API_V1_STR="/api"
SECRET_KEY="replace-with-a-long-random-jwt-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Supabase PostgreSQL (replace password and project ref)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Set true only for offline local development. When true, a failed
# PostgreSQL connection silently uses sqlite:///./avd_crm.db
ALLOW_SQLITE_FALLBACK=false

# Optional pooler URI if direct db.* host is unreachable:
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

UPLOAD_DIR="./uploads"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
